{
  "name": "@tracer-ai/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/workers.js",
    "start": "node src/server.js",
    "start:worker": "node src/workers.js",
    "migrate:sprint-1": "node ../scripts/migrations/001-create-auth-and-user-indexes.js",
    "migrate:sprint-3": "node ../scripts/migrations/002-create-resource-indexes.js",
    "migrate:mvp-completion": "node ../scripts/migrations/003-create-mvp-completion-indexes.js",
    "verify:auth-runtime": "node ../scripts/verify-auth-runtime.js",
    "build": "node --check src/server.js",
    "test": "node --test test/*.test.js",
    "test:live": "node --test test/*.integration.test.js"
  },
  "dependencies": {
    "@tracer-ai/shared": "*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.44.0",
    "bullmq": "^5.79.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "multer": "^2.2.0",
    "openai": "^6.45.0",
    "openid-client": "^6.8.4",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfjs-dist": "^6.1.200",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
