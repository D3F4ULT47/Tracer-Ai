{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracer.ai/schemas/ai/learner-assessment/1.0.0",
  "title": "Tracer AI Learner Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "currentLevel",
    "confidence",
    "reasoning",
    "proficiencyEvidence",
    "knownSkills",
    "missingSkills",
    "suggestedSkills",
    "experienceSignals",
    "educationSignals",
    "technologyStack",
    "careerDirection",
    "projectComplexity",
    "experienceSummary",
    "educationSummary",
    "technologySummary",
    "clarificationRequired"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1.0.0"] },
    "currentLevel": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasoning": { "type": "string" },
    "proficiencyEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "knownSkills": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/skillInference" }
    },
    "missingSkills": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/skillInference" }
    },
    "suggestedSkills": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/skillInference" }
    },
    "experienceSignals": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/signalInference" }
    },
    "educationSignals": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/$defs/signalInference" }
    },
    "technologyStack": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/skillInference" }
    },
    "careerDirection": { "$ref": "#/$defs/optionalInference" },
    "projectComplexity": { "$ref": "#/$defs/optionalInference" },
    "experienceSummary": { "$ref": "#/$defs/optionalInference" },
    "educationSummary": { "$ref": "#/$defs/optionalInference" },
    "technologySummary": { "$ref": "#/$defs/optionalInference" },
    "clarificationRequired": { "type": "boolean" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "excerpt"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["naturalLanguage", "projectDescription", "resumeText"]
        },
        "excerpt": { "type": "string" }
      }
    },
    "skillInference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "confidence", "reasoning", "evidence"],
      "properties": {
        "name": { "type": "string" },
        "category": {
          "type": "string",
          "enum": [
            "programming",
            "data",
            "design",
            "product",
            "business",
            "devops",
            "cloud",
            "security",
            "testing",
            "communication",
            "domain",
            "other"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasoning": { "type": "string" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "signalInference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "reasoning", "evidence"],
      "properties": {
        "value": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasoning": { "type": "string" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "optionalInference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inferred", "value", "confidence", "reasoning", "evidence"],
      "properties": {
        "inferred": { "type": "boolean" },
        "value": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reasoning": { "type": "string" },
        "evidence": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
