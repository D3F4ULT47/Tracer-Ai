{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracer.ai/schemas/ai/resume/1.0.0",
  "title": "Tracer AI Resume Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skills",
    "experience",
    "projects",
    "education",
    "certifications",
    "tools",
    "technologies",
    "currentLevel",
    "confidence"
  ],
  "properties": {
    "skills": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "confidence", "evidence"],
        "properties": {
          "name": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "string" }
        }
      }
    },
    "experience": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "projects": { "type": "array", "items": { "type": "string" }, "maxItems": 50 },
    "education": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
    "certifications": { "type": "array", "items": { "type": "string" }, "maxItems": 30 },
    "tools": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
    "technologies": { "type": "array", "items": { "type": "string" }, "maxItems": 100 },
    "currentLevel": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
