{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracer.ai/schemas/ai/dependency-graph/2.0.0",
  "title": "Tracer AI Internal Planning Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graphVersion", "nodes", "edges"],
  "properties": {
    "graphVersion": { "type": "integer", "const": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "type", "required", "taskKey"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "type": { "type": "string", "enum": ["concept", "task"] },
          "required": { "type": "boolean" },
          "taskKey": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 4000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string", "const": "prerequisite" }
        }
      }
    }
  }
}
