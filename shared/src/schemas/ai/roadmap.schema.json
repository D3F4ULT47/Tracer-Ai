{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracer.ai/schemas/ai/roadmap/2.0.0",
  "title": "Tracer AI Complete Roadmap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "description",
    "summary",
    "estimatedWeeks",
    "currentLevel",
    "weeklyCommitmentHours",
    "confidence",
    "missingSkills",
    "difficulty",
    "completionCriteria",
    "phases"
  ],
  "properties": {
    "type": { "type": "string", "enum": ["career", "skill", "project", "resume"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "estimatedWeeks": { "type": "integer", "minimum": 1, "maximum": 520 },
    "currentLevel": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"]
    },
    "weeklyCommitmentHours": { "type": "number", "minimum": 1, "maximum": 168 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "missingSkills": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"]
    },
    "completionCriteria": { "$ref": "#/$defs/criteria" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/phase" }
    }
  },
  "$defs": {
    "state": {
      "type": "string",
      "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED", "LOCKED"]
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"]
    },
    "keys": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "labels": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "description",
        "estimatedMinutes",
        "difficulty",
        "dependencies",
        "completionCriteria",
        "type",
        "state",
        "notes",
        "resources"
      ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "estimatedMinutes": { "type": "integer", "minimum": 5, "maximum": 2400 },
        "difficulty": { "$ref": "#/$defs/difficulty" },
        "dependencies": { "$ref": "#/$defs/keys" },
        "completionCriteria": { "$ref": "#/$defs/criteria" },
        "type": {
          "type": "string",
          "enum": ["learn", "practice", "project", "assessment", "checkpoint"]
        },
        "state": { "$ref": "#/$defs/state" },
        "notes": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
        "resources": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/resourceLink" }
        },
        "attachments": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/attachment" }
        }
      }
    },
    "resourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "purpose", "sourceRank", "rankingVersion"],
      "properties": {
        "resourceId": { "type": "string", "format": "uuid" },
        "purpose": { "enum": ["primary", "alternative", "reference", "github"] },
        "sourceRank": { "type": "integer", "minimum": 1 },
        "rankingVersion": { "type": "string", "minLength": 1 }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachmentId",
        "type",
        "url",
        "title",
        "description",
        "metadata",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "attachmentId": { "type": "string", "format": "uuid" },
        "type": { "enum": ["youtube", "github", "pdf", "google_doc", "external_url"] },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": ["string", "null"], "maxLength": 2000 },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "host",
            "identifier",
            "resourceId",
            "purpose",
            "rankingVersion",
            "author",
            "thumbnailUrl"
          ],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "host": { "type": "string", "minLength": 1 },
            "identifier": { "type": "string", "minLength": 1 },
            "resourceId": { "type": "string", "format": "uuid" },
            "purpose": { "enum": ["primary", "alternative", "reference", "github"] },
            "rankingVersion": { "type": "string", "minLength": 1 },
            "author": { "type": ["string", "null"] },
            "thumbnailUrl": { "type": ["string", "null"], "format": "uri" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "description",
        "objective",
        "weekNumber",
        "order",
        "state",
        "dependencies",
        "milestones",
        "projects",
        "checkpoints",
        "completionCriteria",
        "tasks"
      ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "weekNumber": { "type": "integer", "minimum": 1, "maximum": 520 },
        "order": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "#/$defs/state" },
        "dependencies": { "$ref": "#/$defs/keys" },
        "milestones": { "$ref": "#/$defs/labels" },
        "projects": { "$ref": "#/$defs/labels" },
        "checkpoints": { "$ref": "#/$defs/labels" },
        "completionCriteria": { "$ref": "#/$defs/criteria" },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "description",
        "objective",
        "estimatedWeeks",
        "order",
        "state",
        "dependencies",
        "milestones",
        "projects",
        "checkpoints",
        "completionCriteria",
        "weeks"
      ],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "estimatedWeeks": { "type": "integer", "minimum": 1, "maximum": 52 },
        "order": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "#/$defs/state" },
        "dependencies": { "$ref": "#/$defs/keys" },
        "milestones": { "$ref": "#/$defs/labels" },
        "projects": { "$ref": "#/$defs/labels" },
        "checkpoints": { "$ref": "#/$defs/labels" },
        "completionCriteria": { "$ref": "#/$defs/criteria" },
        "weeks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 52,
          "items": { "$ref": "#/$defs/week" }
        }
      }
    }
  }
}
