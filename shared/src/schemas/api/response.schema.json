{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracer.ai/schemas/api/response.schema.json",
  "title": "API response envelope",
  "oneOf": [
    {
      "type": "object",
      "required": ["success", "message", "data"],
      "properties": {
        "success": { "const": true },
        "message": { "type": "string" },
        "data": {},
        "requestId": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["success", "message", "error"],
      "properties": {
        "success": { "const": false },
        "message": { "type": "string" },
        "error": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": { "type": "string" },
            "details": {}
          },
          "additionalProperties": false
        },
        "requestId": { "type": "string" }
      },
      "additionalProperties": false
    }
  ]
}
