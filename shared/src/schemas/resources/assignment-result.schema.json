{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracer.ai/schemas/resources/assignment-result/1.0.0",
  "title": "Learning Experience Assignment Result",
  "type": "object",
  "required": ["assignments", "assignmentVersion", "generatedAt"],
  "properties": {
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1500,
      "items": { "$ref": "https://tracer.ai/schemas/resources/learning-experience/1.0.0" }
    },
    "assignmentVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
